{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/perfil/**",
        "function": "perfilSSR"
      },
      {
        "source": "/turismo/**",
        "function": "turismoSSR"
      },
      {
        "source": "/sitemap.xml",
        "function": "sitemap"
      },
      {
        "source": "/redirect/**",
        "destination": "/redirect/index.html"
      },
      {
        "source": "/api/share",
        "function": "share"
      },
      {
        "source": "/pedidos/**",
        "destination": "/pedidos/pedidos.html"
      },

      {
        "source": "/logindata/login",
        "function": "staticSSR"
      },
      {
        "source": "/scree/nostros",
        "function": "staticSSR"
      },
      {
        "source": "/generatorqr",
        "function": "staticSSR"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
