<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Modo Mozo</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script type="module" src="../js/dasboardjs/mozo.js"></script>
  <style>
    :root {
      --bg: #08060d;
      --surface: #0d0a17;
      --surface-2: #151027;
      --line: rgba(139, 92, 246, .16);
      --ink: #f4f2fb;
      --ink-dim: #a89cc4;
      --ink-faint: #6b6088;
      --violet: #7c5cff;
      --violet-soft: rgba(124, 92, 255, .14);
      --amber: #f59e0b;
      --amber-soft: rgba(245, 158, 11, .14);
      --blue: #3b82f6;
      --blue-soft: rgba(59, 130, 246, .14);
      --purple: #c026d3;
      --purple-soft: rgba(192, 38, 211, .16);
      --red: #ef4444;
      --red-soft: rgba(239, 68, 68, .14);
      --green: #22c55e;
      --green-soft: rgba(34, 197, 94, .14);
    }

    * {
      -webkit-tap-highlight-color: transparent;
    }

    html,
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overscroll-behavior-y: none;
    }

    .mono {
      font-family: 'SF Mono', ui-monospace, Menlo, monospace;
    }

    .surface {
      background: var(--surface);
      border: 1px solid var(--line);
    }

    .surface-2 {
      background: var(--surface-2);
      border: 1px solid var(--line);
    }

    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    ::-webkit-scrollbar-thumb {
      background: rgba(139, 92, 246, .25);
      border-radius: 8px;
    }

    .thin-scroll::-webkit-scrollbar {
      width: 5px;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(6px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-fadeIn {
      animation: fadeIn .25s ease both;
    }

    @keyframes pulseDot {

      0%,
      100% {
        opacity: 1;
      }

      50% {
        opacity: .35;
      }
    }

    .pulse-dot {
      animation: pulseDot 1.6s ease-in-out infinite;
    }

    @keyframes ring {

      0%,
      100% {
        transform: rotate(0);
      }

      10%,
      30% {
        transform: rotate(-12deg);
      }

      20%,
      40% {
        transform: rotate(12deg);
      }
    }

    .ring-anim {
      animation: ring .5s ease-in-out;
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(10px) scale(.97);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .toast-in {
      animation: toastIn .18s ease both;
    }

    .overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      background: rgba(3, 2, 8, .82);
      backdrop-filter: blur(6px);
    }

    .overlay.show {
      display: flex;
    }

    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(255, 255, 255, .3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin .6s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .mesa-card {
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: 20px;
      padding: 14px;
      cursor: pointer;
      transition: transform .12s ease, border-color .12s ease;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-height: 140px;
    }

    .mesa-card:active {
      transform: scale(.97);
    }

    .mesa-card.st-libre {
      border-color: rgba(34, 197, 94, .25);
    }

    .mesa-card.st-pendiente {
      border-color: rgba(245, 158, 11, .55);
      box-shadow: 0 0 0 1px rgba(245, 158, 11, .2) inset;
    }

    .mesa-card.st-preparacion {
      border-color: rgba(59, 130, 246, .5);
    }

    .mesa-card.st-listo {
      border-color: rgba(192, 38, 211, .6);
      box-shadow: 0 0 0 1px rgba(192, 38, 211, .25) inset;
    }

    .mesa-card.st-cuenta {
      border-color: rgba(239, 68, 68, .6);
      box-shadow: 0 0 0 1px rgba(239, 68, 68, .25) inset;
    }

    .mesa-card.st-reservada {
      border-color: rgba(124, 92, 255, .5);
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 999px;
      letter-spacing: .02em;
    }

    .btn-primary {
      background: var(--violet);
      color: #fff;
      font-weight: 700;
      border-radius: 14px;
      padding: 12px;
      transition: filter .12s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-primary:hover {
      filter: brightness(1.1);
    }

    .btn-primary:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    .btn-ghost {
      background: rgba(255, 255, 255, .05);
      color: var(--ink);
      font-weight: 600;
      border-radius: 14px;
      padding: 12px;
      transition: background .12s;
    }

    .btn-ghost:hover {
      background: rgba(255, 255, 255, .09);
    }

    .btn-danger {
      background: var(--red-soft);
      color: #fca5a5;
      font-weight: 700;
      border-radius: 14px;
      padding: 12px;
      transition: filter .12s;
    }

    .btn-danger:hover {
      filter: brightness(1.2);
    }

    .field-input {
      width: 100%;
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 10px 12px;
      font-size: 13.5px;
      color: var(--ink);
      outline: none;
    }

    .field-input:focus {
      border-color: var(--violet);
    }

    .qty-btn {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: rgba(255, 255, 255, .06);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 16px;
      color: var(--ink);
    }

    .qty-btn:active {
      transform: scale(.9);
    }

    .cat-chip {
      flex-shrink: 0;
      font-size: 11.5px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 999px;
      background: var(--surface-2);
      border: 1px solid var(--line);
      color: var(--ink-dim);
      white-space: nowrap;
      transition: all .12s;
    }

    .cat-chip.active {
      background: var(--violet);
      color: #fff;
      border-color: var(--violet);
    }

    .toggle-opt {
      font-size: 12px;
      font-weight: 700;
      padding: 7px 12px;
      border-radius: 12px;
      background: var(--surface-2);
      border: 1px solid var(--line);
      color: var(--ink-dim);
      cursor: pointer;
      transition: all .12s;
    }

    .toggle-opt.active {
      background: var(--violet);
      color: #fff;
      border-color: var(--violet);
    }

    .toggle-opt.agotado {
      opacity: .4;
      text-decoration: line-through;
      cursor: not-allowed;
    }

    .stock-badge {
      font-size: 9.5px;
      font-weight: 800;
      padding: 2px 6px;
      border-radius: 6px;
      letter-spacing: .02em;
    }

    .stock-ok {
      background: var(--green-soft);
      color: #6ee7a0;
    }

    .stock-bajo {
      background: var(--amber-soft);
      color: #fbbf6b;
    }

    .stock-agotado {
      background: var(--red-soft);
      color: #fca5a5;
    }

    #toastWrap {
      position: fixed;
      bottom: 16px;
      right: 16px;
      left: 16px;
      z-index: 300;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    @media(min-width:640px) {
      #toastWrap {
        left: auto;
      }
    }
  </style>
</head>

<body class="min-h-screen pb-10">

  <!-- ══════════════ Loader inicial ══════════════ -->
  <div id="pageLoader" class="fixed inset-0 z-[400] bg-[#08060d] flex flex-col items-center justify-center gap-3">
    <div class="w-10 h-10 rounded-full border-2 border-violet-900 border-t-violet-400"
      style="animation:spin .7s linear infinite;"></div>
    <p class="text-xs text-[var(--ink-faint)] font-mono">Cargando Modo Mozo…</p>
  </div>

  <!-- ══════════════ Selector de mozo (bloquea hasta elegir) ══════════════ -->
  <div id="mozoSelectOverlay" class="overlay" style="z-index:250;">
    <div class="surface rounded-3xl p-6 w-full max-w-sm">
      <h2 class="font-extrabold text-lg mb-1">¿Quién eres?</h2>
      <p class="text-xs text-[var(--ink-dim)] mb-5">Elige tu nombre para empezar a atender mesas.</p>
      <div id="mozoListWrap" class="flex flex-col gap-2 mb-4 max-h-64 overflow-y-auto thin-scroll"></div>
      <div id="mozoEmptyMsg" class="hidden text-xs text-[var(--ink-faint)] mb-4">Aún no hay mozos registrados. Agrega el
        primero abajo.</div>
      <div class="flex gap-2">
        <input id="inputNuevoMozo" type="text" placeholder="Nombre del nuevo mozo" maxlength="40"
          class="field-input flex-1">
        <button id="btnAgregarMozo" class="btn-primary px-4" style="width:auto;">
          <span id="btnAgregarMozoLabel">+ Agregar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════ App principal ══════════════ -->
  <div id="app" class="hidden">

    <header class="sticky top-0 z-30 backdrop-blur-xl bg-black/85 border-b border-[var(--line)] px-4 sm:px-6 py-3">
      <div class="max-w-[1400px] mx-auto flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5 min-w-0">
          <div
            class="w-9 h-9 rounded-xl bg-violet-950/60 border border-violet-800/40 flex items-center justify-center text-base flex-shrink-0">
            🧑‍🍳</div>
          <div class="min-w-0">
            <h1 class="font-extrabold text-[15px] leading-tight">Modo Mozo</h1>
            <p class="text-[11px] text-[var(--ink-faint)] truncate">Atendiendo como <span id="mozoActivoNombre"
                class="text-violet-300 font-semibold">—</span></p>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <button id="btnSonido" title="Sonido"
            class="w-9 h-9 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-base">🔔</button>
          <button id="btnCambiarMozo"
            class="text-[11px] font-semibold text-[var(--ink-dim)] hover:text-white px-3 py-2 rounded-xl bg-white/5">Cambiar</button>
        </div>
      </div>
    </header>

    <main class="max-w-[1400px] mx-auto px-4 sm:px-6 py-5">

      <!-- Panel de indicadores -->
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5 mb-6">
        <div class="surface rounded-2xl p-3.5">
          <p class="text-[10px] uppercase tracking-wider font-bold text-[var(--ink-faint)] mb-1">Mesas ocupadas</p>
          <p class="text-2xl font-extrabold" id="ind-ocupadas">0</p>
        </div>
        <div class="surface rounded-2xl p-3.5" style="border-color:rgba(245,158,11,.3);">
          <p class="text-[10px] uppercase tracking-wider font-bold text-amber-400/80 mb-1">Por confirmar</p>
          <p class="text-2xl font-extrabold text-amber-400" id="ind-pendientes">0</p>
        </div>
        <div class="surface rounded-2xl p-3.5" style="border-color:rgba(239,68,68,.3);">
          <p class="text-[10px] uppercase tracking-wider font-bold text-red-400/80 mb-1">Llamados</p>
          <p class="text-2xl font-extrabold text-red-400" id="ind-llamados">0</p>
        </div>
        <div class="surface rounded-2xl p-3.5" style="border-color:rgba(192,38,211,.3);">
          <p class="text-[10px] uppercase tracking-wider font-bold text-fuchsia-400/80 mb-1">Listos</p>
          <p class="text-2xl font-extrabold text-fuchsia-400" id="ind-listos">0</p>
        </div>
        <div class="surface rounded-2xl p-3.5 col-span-2 sm:col-span-1" style="border-color:rgba(239,68,68,.3);">
          <p class="text-[10px] uppercase tracking-wider font-bold text-red-400/80 mb-1">Piden cuenta</p>
          <p class="text-2xl font-extrabold text-red-400" id="ind-cuenta">0</p>
        </div>
      </div>

      <!-- Leyenda -->
      <div class="flex flex-wrap gap-x-4 gap-y-1.5 mb-5 text-[11px] text-[var(--ink-dim)]">
        <span>🟢 Libre</span>
        <span>🟠 Por confirmar</span>
        <span>🔵 En preparación</span>
        <span>🟣 Listo</span>
        <span>🔴 Pide la cuenta</span>
        <span>🟣 Reservada</span>
      </div>

      <div id="mesaGrid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3"></div>

      <div id="emptyMesas" class="hidden flex-col items-center text-center py-24 gap-2">
        <div class="w-14 h-14 rounded-2xl bg-white/5 flex items-center justify-center text-2xl">🍽️</div>
        <p class="font-bold text-[var(--ink-dim)]">Todavía no hay mesas registradas</p>
      </div>
    </main>
  </div>

  <!-- ══════════════ Modal detalle de mesa ══════════════ -->
  <div class="overlay" id="overlay-detalle">
    <div class="surface rounded-3xl w-full max-w-lg max-h-[92vh] overflow-y-auto thin-scroll">
      <div class="sticky top-0 surface z-10 px-5 pt-5 pb-4 border-b border-[var(--line)]">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="font-extrabold text-lg" id="det-titulo">Mesa —</h2>
            <p class="text-[11.5px] text-[var(--ink-dim)] mt-0.5" id="det-subtitulo">—</p>
          </div>
          <button data-close="overlay-detalle"
            class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center flex-shrink-0">✕</button>
        </div>
        <div class="flex flex-wrap gap-2 mt-3">
          <span class="chip" id="det-chip-estado" style="background:var(--surface-2); color:var(--ink-dim);">—</span>
          <span class="chip" id="det-chip-tiempo" style="background:var(--surface-2); color:var(--ink-dim);">⏱ —</span>
        </div>
      </div>

      <div class="px-5 py-4 flex flex-col gap-4">

        <!-- Mozo asignado + personas -->
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label class="text-[10px] uppercase tracking-wider font-bold text-[var(--ink-faint)] block mb-1.5">Mozo
              asignado</label>
            <select id="det-mozo-select" class="field-input"></select>
          </div>
          <div>
            <label
              class="text-[10px] uppercase tracking-wider font-bold text-[var(--ink-faint)] block mb-1.5">Personas</label>
            <input id="det-personas" type="number" min="0" placeholder="—" class="field-input">
          </div>
        </div>

        <!-- Llamado activo -->
        <div id="det-llamado-banner" class="hidden rounded-2xl p-3 flex items-center justify-between gap-3"
          style="background:var(--red-soft); border:1px solid rgba(239,68,68,.3);">
          <div class="min-w-0">
            <p class="text-[11px] font-bold text-red-300 uppercase tracking-wide">Solicitud del cliente</p>
            <p class="text-sm font-semibold text-red-100" id="det-llamado-motivo">—</p>
          </div>
          <button id="det-llamado-atender" class="btn-ghost text-xs px-3 py-2 flex-shrink-0">Marcar atendido</button>
        </div>

        <!-- Productos -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-[11px] uppercase tracking-wider font-bold text-[var(--ink-faint)]">Productos del pedido</h3>
            <button id="btn-agregar-producto"
              class="text-[11.5px] font-bold text-violet-300 hover:text-violet-200 flex items-center gap-1">
              <span>+</span> Agregar
            </button>
          </div>
          <div id="det-productos" class="flex flex-col gap-2"></div>
          <p id="det-sin-productos" class="hidden text-xs text-[var(--ink-faint)] py-4 text-center">Sin productos
            todavía. Usa "+ Agregar" para iniciar el pedido.</p>
        </div>

        <!-- Nota del cliente -->
        <div>
          <label class="text-[10px] uppercase tracking-wider font-bold text-[var(--ink-faint)] block mb-1.5">Nota del
            cliente</label>
          <p class="text-sm text-[var(--ink-dim)] surface-2 rounded-xl px-3 py-2.5" id="det-nota-cliente">—</p>
        </div>

        <!-- Nota interna del mozo -->
        <div>
          <label class="text-[10px] uppercase tracking-wider font-bold text-[var(--ink-faint)] block mb-1.5">Nota
            interna (no la ve el cliente)</label>
          <textarea id="det-nota-interna" rows="2" placeholder="Ej. Cliente alérgico al maní, mesa VIP…"
            class="field-input resize-none"></textarea>
        </div>

        <!-- Total -->
        <div class="flex items-center justify-between pt-2 border-t border-[var(--line)]">
          <span class="text-sm font-semibold text-[var(--ink-dim)]">Total</span>
          <span class="font-extrabold text-xl mono" id="det-total">S/ 0.00</span>
        </div>
      </div>

      <!-- Acciones -->
      <div class="px-5 pb-5 pt-1 flex flex-col gap-2 sticky bottom-0 surface">
        <div class="grid grid-cols-2 gap-2">
          <button id="det-btn-guardar" class="btn-ghost">Guardar cambios</button>
          <button id="det-btn-confirmar" class="btn-primary">
            <span id="det-btn-confirmar-label">Confirmar y enviar a cocina</span>
          </button>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <button id="det-btn-cancelar-pedido" class="btn-danger text-xs">Cancelar pedido completo</button>
          <button id="det-btn-liberar" class="btn-ghost text-xs">Liberar mesa</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════ Modal agregar producto ══════════════ -->
  <div class="overlay" id="overlay-picker">
    <div class="surface rounded-3xl w-full max-w-md max-h-[85vh] flex flex-col">
      <div class="px-5 pt-5 pb-3 border-b border-[var(--line)] flex items-center justify-between flex-shrink-0">
        <h3 class="font-extrabold text-base">Agregar producto</h3>
        <button data-close="overlay-picker"
          class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center">✕</button>
      </div>
      <div class="px-5 pt-3 pb-2 flex-shrink-0">
        <input id="picker-search" type="text" placeholder="Buscar producto…" class="field-input">
      </div>
      <div id="picker-categorias" class="flex gap-1.5 overflow-x-auto thin-scroll px-5 pb-3 flex-shrink-0"></div>
      <div id="picker-lista" class="flex-1 overflow-y-auto thin-scroll px-5 pb-5 flex flex-col gap-2"></div>
    </div>
  </div>

  <!-- ══════════════ Modal de opciones/condiciones del producto (ej. helada / sin helar) ══════════════ -->
  <div class="overlay" id="overlay-picker-opciones">
    <div class="surface rounded-3xl w-full max-w-sm max-h-[85vh] overflow-y-auto thin-scroll">
      <div class="px-5 pt-5 pb-3 border-b border-[var(--line)] flex items-center justify-between">
        <div>
          <h3 class="font-extrabold text-base" id="opciones-prod-nombre">Elige las opciones</h3>
          <p class="text-[11px] text-[var(--ink-faint)] mt-0.5">Selecciona antes de agregar al pedido</p>
        </div>
        <button data-close="overlay-picker-opciones"
          class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center flex-shrink-0">✕</button>
      </div>
      <div class="px-5 py-4 flex flex-col gap-4" id="opciones-body"></div>
      <div class="px-5 pb-5">
        <button id="opciones-btn-agregar" class="btn-primary w-full">Agregar al pedido</button>
      </div>
    </div>
  </div>

  <!-- ══════════════ Confirmación genérica ══════════════ -->
  <div class="overlay" id="overlay-confirm">
    <div class="surface rounded-3xl w-full max-w-sm p-6 text-center">
      <h3 class="font-extrabold text-base mb-1" id="confirm-title">¿Confirmar?</h3>
      <p class="text-xs text-[var(--ink-dim)] mb-5" id="confirm-body">Esta acción no se puede deshacer.</p>
      <div class="flex gap-2.5">
        <button data-close="overlay-confirm" class="btn-ghost flex-1">Cancelar</button>
        <button id="btn-confirm-action" class="btn-danger flex-1 flex items-center justify-center">
          <span id="btn-confirm-action-label">Sí, continuar</span>
        </button>
      </div>
    </div>
  </div>

  <div id="toastWrap"></div>
</body>

</html>